<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup / device-transfer rules.

    `allowBackup="false"` already switches off cloud backup, but on Android 12
    and later it does NOT by itself stop device-to-device transfer. The WebView
    holds an authenticated Auth.js session cookie for a yard, so nothing about
    this app should be copied off the device or onto another one — say so
    explicitly for both channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
