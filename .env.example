# ---- Database (Neon PostgreSQL, pooled connection string) ----
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# ---- NextAuth / Auth.js (generate: openssl rand -base64 32) ----
AUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Vercel Blob (Storage tab in Vercel → create store → copy token) ----
# Leave empty for local dev (images are written to /public/uploads instead).
BLOB_READ_WRITE_TOKEN=""

# ---- ANPR / OCR microservice ----
OCR_SERVICE_URL="http://localhost:8000"
OCR_SERVICE_SECRET="change-me-shared-secret"
