# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ---- Database (Neon PostgreSQL) ----
# Pooled endpoint (host contains `-pooler`). Every application query.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&connection_limit=30&pool_timeout=20"
# UNPOOLED endpoint — same database, same credentials, host WITHOUT `-pooler`.
# Required: `prisma migrate` holds an advisory lock and the realtime bus holds a
# LISTEN, and transaction pooling silently discards both. Not a second database.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# ---- NextAuth / Auth.js (generate: openssl rand -base64 32) ----
AUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_SECRET="replace-with-strong-secret"
# Public origin of the deployment, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3001"

# ---- Vercel Blob (Storage tab in Vercel → create store → copy token) ----
# Required in production: Vercel's filesystem is read-only, so there is no local
# fallback there. Leave empty for local/self-hosted dev, where images are written
# to the gitignored `.uploads/` directory and served through the gated route.
BLOB_READ_WRITE_TOKEN=""

# ---- ANPR / OCR microservice ----
OCR_SERVICE_URL="http://localhost:8000"
OCR_SERVICE_SECRET="change-me-shared-secret"
# `1` re-enables the per-request ANPR diagnostic lines. Off by default.
OCR_DEBUG="0"
